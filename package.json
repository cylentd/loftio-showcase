{
  "name": "loftio-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import ./tests/support/register.ts --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "build": "npm run typecheck && vite build --config vite.showcase.config.ts --outDir ../dist"
  },
  "dependencies": {
    "iron-session": "9.0.1",
    "openid-client": "6.8.9",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
